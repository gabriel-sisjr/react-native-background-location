ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '16.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# Motion activity (CoreMotion) support in @gabriel-sisjr/react-native-background-location.
# CI builds the example with it off; `EXAMPLE_MOTION_ACTIVITY=1 bundle exec pod install`
# compiles it in for device tests.
$BackgroundLocationMotionActivity = ENV['EXAMPLE_MOTION_ACTIVITY'] == '1'

target 'BackgroundLocationExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # React Native's prepare_react_native_project! disables CocoaPods deterministic UUIDs
    # (install! 'cocoapods', :deterministic_uuids => false), so the Pods project keeps sequential
    # object IDs; that is why this override is needed. CocoaPods stabilizes target UUIDs right
    # before post_install and leaves a nearly empty UUID pool. When a hook adds objects after the
    # pool runs dry (the MapLibre Swift package below), numbering restarts at index 0 and can reuse
    # an existing UUID, the root object's included, after which Xcode reports the Pods project as
    # damaged. Skip UUIDs already in use; when no generated UUID is in use this changes nothing.
    if (pods_project = installer.pods_project)
      def pods_project.generate_uuid
        uuid = super
        uuid = super while objects_by_uuid.key?(uuid)
        uuid
      end
    end

    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Call MapLibre post_install to configure SPM dependencies
    # The MapLibre podspec defines a $MLRN.post_install method that needs to be called
    # This configures the Swift Package Manager dependency for MapLibre
    begin
      maplibre_podspec_path = File.join(
        Pod::Config.instance.installation_root,
        '..',
        'node_modules',
        '@maplibre',
        'maplibre-react-native',
        'maplibre-react-native.podspec'
      )
      if File.exist?(maplibre_podspec_path)
        # Load the podspec to get access to $MLRN global object
        load maplibre_podspec_path
        # Call the post_install hook to configure SPM dependencies
        if defined?($MLRN) && $MLRN.respond_to?(:post_install)
          $MLRN.post_install(installer)
        end
      end
    rescue => e
      Pod::UI.warn "Failed to configure MapLibre: #{e.message}"
      Pod::UI.warn e.backtrace.first(5).join("\n")
    end

    # Fix Xcode 26 / iOS 26 SDK compatibility for C++ pods
    # fmt consteval errors, glog/Yoga warnings-as-errors on new clang
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        case target.name
        when 'fmt'
          # Downgrade fmt to C++17 so consteval is unavailable (fmt supports C++11-20)
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        when 'glog'
          config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        when 'Yoga'
          config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        end
      end
    end
  end
end
