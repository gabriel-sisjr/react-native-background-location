{
  // Intentionally NOT extending the root tsconfig.
  // Root tsconfig targets React Native (jsx, ESNext, bundler resolution, verbatimModuleSyntax,
  // customConditions: ["react-native-strict-api"]). This file targets plain Node.
  "compilerOptions": {
    "target": "es2019",
    "lib": ["es2019"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "build",
    "rootDir": "src",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "6.0",
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["build", "**/__tests__/**", "**/*.test.ts"]
}
